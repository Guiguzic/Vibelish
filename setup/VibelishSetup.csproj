<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 随 Windows 10 1903+ / Windows 11 自带，安装包本身不需要用户先装 .NET 运行时。
         装进去的主程序是自包含的单文件版。 -->
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>VibelishSetup</AssemblyName>
    <RootNamespace>VibelishSetup</RootNamespace>
    <ApplicationIcon>..\assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.3.1</Version>
    <Product>Vibelish</Product>
    <Description>Vibelish 安装程序</Description>
    <GenerateSupportedRuntime>true</GenerateSupportedRuntime>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\UiKit.cs" Link="UiKit.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="payload.zip" LogicalName="VibelishSetup.payload.zip" Condition="Exists('payload.zip')" />
    <EmbeddedResource Include="..\assets\app.ico" LogicalName="VibelishSetup.app.ico" />
  </ItemGroup>
</Project>
