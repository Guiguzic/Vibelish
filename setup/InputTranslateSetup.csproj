<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>InputTranslateSetup</AssemblyName>
    <RootNamespace>InputTranslateSetup</RootNamespace>
    <ApplicationIcon>..\assets\app.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\UiKit.cs" Link="UiKit.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="payload.zip" LogicalName="InputTranslateSetup.payload.zip" />
    <EmbeddedResource Include="..\assets\app.ico" LogicalName="InputTranslateSetup.app.ico" />
  </ItemGroup>
</Project>
